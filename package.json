  "license": "ISC",
  "author": "Abraham Schilling",
  "scripts": {
    "build": "gulp build",
    "copy-fonts": "gulp copyFonts",
    "db": "tsx --tsconfig db/tsconfig.json db/cli.ts",
    "db:watch": "nodemon --watch db --ext * --exec npm run db",
    "dev": "npm run copy-fonts && ng serve --open",
    "generate": "rm -rf generated && npm run db && npm run gulp",
    "gulp": "gulp",
    "prod": "npm run build && http-server dist/celeste-search",
    "serve": "npm run copy-fonts && ng serve",
    "start": "npm run copy-fonts && ng serve",
    "test": "ng test",
    "db:typecheck": "tsc -p db/tsconfig.json --noEmit"
  },
